<Window x:Class="MachineClient.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Machine Management Client" 
        Height="800" Width="1200"
        MinHeight="600" MinWidth="800"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <materialDesign:DialogHost Identifier="RootDialog">
        <materialDesign:DrawerHost IsLeftDrawerOpen="{Binding ElementName=MenuToggleButton, Path=IsChecked}">
            <materialDesign:DrawerHost.LeftDrawerContent>
                <!-- Navigation Menu -->
                <DockPanel MinWidth="212">
                    <StackPanel DockPanel.Dock="Top" Margin="0,20">
                        <Image Width="80" Height="80" 
                               Source="pack://application:,,,/MachineClient.WPF;component/Resources/factory-icon.png" 
                               Margin="0,0,0,10"/>
                        <TextBlock Text="Machine Client" 
                                   HorizontalAlignment="Center" 
                                   FontSize="18" 
                                   FontWeight="Medium"/>
                    </StackPanel>
                    
                    <ListBox x:Name="MenuListBox" 
                             Margin="0,16,0,16"
                             SelectedIndex="0"
                             ItemContainerStyle="{StaticResource MaterialDesignNavigationRailListBoxItem}">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Margin="32,0,32,0">
                                <materialDesign:PackIcon Kind="ViewDashboard" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Margin="32,0,32,0">
                                <materialDesign:PackIcon Kind="Cog" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Machines"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Margin="32,0,32,0">
                                <materialDesign:PackIcon Kind="FileDocumentOutline" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Logs"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Margin="32,0,32,0">
                                <materialDesign:PackIcon Kind="Settings" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </materialDesign:DrawerHost.LeftDrawerContent>

            <DockPanel>
                <!-- Top Bar -->
                <materialDesign:ColorZone Padding="16" 
                                        materialDesign:ElevationAssist.Elevation="Dp4"
                                        DockPanel.Dock="Top"
                                        Mode="PrimaryMid">
                    <DockPanel>
                        <ToggleButton x:Name="MenuToggleButton"
                                    Style="{DynamicResource MaterialDesignHamburgerToggleButton}"
                                    DockPanel.Dock="Left"
                                    IsChecked="False"/>
                        
                        <TextBlock HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontSize="22"
                                 FontWeight="Medium"
                                 Text="Industrial Machine Management"/>
                        
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <materialDesign:PackIcon Kind="Circle" 
                                                   VerticalAlignment="Center" 
                                                   Foreground="LightGreen" 
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Connected" 
                                     VerticalAlignment="Center" 
                                     FontWeight="Medium"/>
                        </StackPanel>
                    </DockPanel>
                </materialDesign:ColorZone>

                <!-- Main Content Area -->
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Status Cards -->
                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
                        <!-- Total Machines Card -->
                        <materialDesign:Card Margin="8" Padding="16">
                            <StackPanel>
                                <DockPanel>
                                    <materialDesign:PackIcon Kind="Factory" 
                                                           DockPanel.Dock="Right" 
                                                           Width="24" Height="24" 
                                                           VerticalAlignment="Top" 
                                                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    <StackPanel>
                                        <TextBlock Text="Total Machines" 
                                                 FontWeight="Medium" 
                                                 Opacity=".68"/>
                                        <TextBlock Text="124" 
                                                 FontSize="28" 
                                                 FontWeight="Bold"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Running Machines Card -->
                        <materialDesign:Card Margin="8" Padding="16">
                            <StackPanel>
                                <DockPanel>
                                    <materialDesign:PackIcon Kind="Play" 
                                                           DockPanel.Dock="Right" 
                                                           Width="24" Height="24" 
                                                           VerticalAlignment="Top" 
                                                           Foreground="Green"/>
                                    <StackPanel>
                                        <TextBlock Text="Running" 
                                                 FontWeight="Medium" 
                                                 Opacity=".68"/>
                                        <TextBlock Text="98" 
                                                 FontSize="28" 
                                                 FontWeight="Bold"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Idle Machines Card -->
                        <materialDesign:Card Margin="8" Padding="16">
                            <StackPanel>
                                <DockPanel>
                                    <materialDesign:PackIcon Kind="Pause" 
                                                           DockPanel.Dock="Right" 
                                                           Width="24" Height="24" 
                                                           VerticalAlignment="Top" 
                                                           Foreground="Orange"/>
                                    <StackPanel>
                                        <TextBlock Text="Idle" 
                                                 FontWeight="Medium" 
                                                 Opacity=".68"/>
                                        <TextBlock Text="18" 
                                                 FontSize="28" 
                                                 FontWeight="Bold"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Error Machines Card -->
                        <materialDesign:Card Margin="8" Padding="16">
                            <StackPanel>
                                <DockPanel>
                                    <materialDesign:PackIcon Kind="Alert" 
                                                           DockPanel.Dock="Right" 
                                                           Width="24" Height="24" 
                                                           VerticalAlignment="Top" 
                                                           Foreground="Red"/>
                                    <StackPanel>
                                        <TextBlock Text="Alerts" 
                                                 FontWeight="Medium" 
                                                 Opacity=".68"/>
                                        <TextBlock Text="8" 
                                                 FontSize="28" 
                                                 FontWeight="Bold"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </materialDesign:Card>
                    </UniformGrid>

                    <!-- Main Content -->
                    <materialDesign:Card Grid.Row="1" Margin="8">
                        <Grid>
                            <TextBlock Text="Machine data and controls will appear here..." 
                                     HorizontalAlignment="Center" 
                                     VerticalAlignment="Center"
                                     FontSize="16"
                                     Opacity=".68"/>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </DockPanel>
        </materialDesign:DrawerHost>
    </materialDesign:DialogHost>
</Window>